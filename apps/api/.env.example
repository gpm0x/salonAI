# ── Servidor ─────────────────────────────────────────
PORT=3333
NODE_ENV=development
# Origem liberada no CORS em produção (o app Next)
FRONTEND_URL=http://localhost:3000

# ── Banco (Supabase PostgreSQL) ──────────────────────
# MESMA URL de apps/web/.env.local: o Better Auth grava as sessões aqui
# e o auth.plugin do Fastify valida o Bearer token contra a tabela `session`.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# ── Rate limit distribuído (opcional; sem isso usa memória local) ──
# REDIS_URL=redis://localhost:6379

# ── Stripe (opcional no MVP) ─────────────────────────
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price ID (recorrência mensal) do plano Essencial no Stripe Dashboard
# STRIPE_PRICE_ESSENTIAL_MONTHLY=price_xxx
