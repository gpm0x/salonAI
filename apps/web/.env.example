# ── URLs ─────────────────────────────────────────────
# API Fastify (apps/api)
NEXT_PUBLIC_API_URL=http://localhost:3333
# URL pública deste app — usada como baseURL do Better Auth no cliente
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Better Auth (roda dentro do Next, em app/api/auth/[...all]) ──
# MESMO banco usado por apps/api: o Fastify valida a sessão lendo a tabela `session`
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-segredo-aleatorio-de-32-bytes
BETTER_AUTH_URL=http://localhost:3000
