generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ────────────────────────────────────────────────────────
// Better Auth tables (managed by Better Auth)
// ────────────────────────────────────────────────────────

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  organizations Organization[]

  @@map("user")
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ────────────────────────────────────────────────────────
// Business Models
// ────────────────────────────────────────────────────────

model Organization {
  id                   String   @id @default(uuid())
  name                 String
  ownerId              String
  slug                 String?  @unique
  subscriptionStatus   String   @default("trialing")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  salons        Salon[]
  professionals Professional[]
  clients       Client[]
  services      Service[]
  appointments  Appointment[]
  transactions  Transaction[]
  alerts        Alert[]

  @@index([ownerId])
  @@map("organization")
}

model Salon {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  address        String?
  city           String?
  phone          String?
  businessHours  String?
  totalChairs    Int      @default(1)
  isActive       Boolean  @default(true)
  isMain         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professionals Professional[]
  appointments  Appointment[]

  @@index([organizationId])
  @@map("salon")
}

model Professional {
  id              String   @id @default(uuid())
  organizationId  String
  salonId         String?
  name            String
  specialty       String?
  email           String?
  phone           String?
  status          String   @default("ativo")
  commissionPct   Decimal  @default(0)
  rating          Decimal  @default(0)
  workingServices String[] @default([])
  workingDays     String[] @default([])
  workingHours    String?
  hiredAt         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon        Salon?        @relation(fields: [salonId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  transactions Transaction[]
  clientsPreferred Client[] @relation("PreferredProfessional")

  @@index([organizationId])
  @@index([salonId])
  @@map("professional")
}

model Client {
  id                      String   @id @default(uuid())
  organizationId          String
  name                    String
  email                   String?
  phone                   String?
  status                  String   @default("novo")
  birthday                String?
  favoriteService         String?
  preferredProfessionalId String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  preferredProfessional Professional? @relation("PreferredProfessional", fields: [preferredProfessionalId], references: [id], onDelete: SetNull)
  appointments          Appointment[]
  transactions          Transaction[]

  @@index([organizationId])
  @@map("client")
}

model Service {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  category       String
  durationMin    Int
  priceCents     Int
  commissionPct  Decimal  @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([organizationId])
  @@map("service")
}

model Appointment {
  id             String   @id @default(uuid())
  organizationId String
  salonId        String
  professionalId String
  clientId       String
  serviceId      String
  startsAt       DateTime
  endsAt         DateTime
  status         String   @default("scheduled")
  priceCents     Int
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  professional Professional  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([organizationId])
  @@index([salonId])
  @@index([professionalId])
  @@index([clientId])
  @@index([organizationId, startsAt])
  @@map("appointment")
}

model Transaction {
  id             String   @id @default(uuid())
  organizationId String
  appointmentId  String?
  clientId       String?
  professionalId String?
  serviceName    String?
  amountCents    Int
  paymentMethod  String
  paidAt         DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, paidAt])
  @@map("transaction")
}

model Alert {
  id             String   @id @default(uuid())
  organizationId String
  area           String
  tone           String
  title          String
  description    String
  impactCents    Int      @default(0)
  confidence     Int      @default(0)
  action         String?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("alert")
}
