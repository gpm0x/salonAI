{
  "info": {
    "name": "SalonAI API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:3333" },
    { "key": "APP_URL", "value": "http://localhost:3000" },
    { "key": "TOKEN", "value": "" },
    { "key": "AUTH_EMAIL", "value": "" },
    { "key": "AUTH_PASSWORD", "value": "" },
    { "key": "salonId", "value": "" },
    { "key": "clientId", "value": "" },
    { "key": "professionalId", "value": "" },
    { "key": "serviceId", "value": "" },
    { "key": "appointmentId", "value": "" },
    { "key": "transactionId", "value": "" },
    { "key": "alertId", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "const token = pm.collectionVariables.get('TOKEN');",
          "if (token && token.length > 10) return;",
          "",
          "const appUrl = pm.collectionVariables.get('APP_URL') || 'http://localhost:3000';",
          "const email = pm.collectionVariables.get('AUTH_EMAIL');",
          "const password = pm.collectionVariables.get('AUTH_PASSWORD');",
          "",
          "if (!email || !password) {",
          "  console.error('AUTH_EMAIL ou AUTH_PASSWORD nao configurados nas variaveis da collection.');",
          "  return;",
          "}",
          "",
          "pm.sendRequest({",
          "  url: appUrl + '/api/auth/sign-in/email',",
          "  method: 'POST',",
          "  header: {",
          "    'Content-Type': 'application/json',",
          "    'Origin': appUrl",
          "  },",
          "  body: { mode: 'raw', raw: JSON.stringify({ email: email, password: password }) }",
          "}, function(err, res) {",
          "  if (err) { console.error('Auto sign-in falhou:', err); return; }",
          "  const json = res.json();",
          "  const t = json.token || (json.data && json.data.token) || (json.data && json.data.session && json.data.session.token);",
          "  if (t) {",
          "    pm.collectionVariables.set('TOKEN', t);",
          "    console.log('Auto sign-in OK — TOKEN salvo.');",
          "  } else {",
          "    console.error('Auto sign-in falhou (status ' + res.code + '):', JSON.stringify(json));",
          "  }",
          "});"
        ]
      }
    }
  ],
