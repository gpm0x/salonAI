{
  "name": "salon-saas",
  "version": "0.1.0",
  "private": true,
  "description": "SaaS de gestão para salões de beleza — monorepo (Next.js + Fastify + Prisma/Supabase)",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:api": "pnpm --filter @salon/api dev",
    "dev:web": "pnpm --filter @salon/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @salon/api db:generate",
    "db:push": "pnpm --filter @salon/api db:push",
    "db:studio": "pnpm --filter @salon/api db:studio",
    "generate:api": "pnpm --filter @salon/web generate:api"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=20.19.2"
  },
  "pnpm": {
    "overrides": {
      "lodash": ">=4.18.0",
      "postcss": ">=8.5.23",
      "sharp": ">=0.35.0",
      "js-yaml": "^4.3.1",
      "nanoid": ">=3.3.18",
      "find-my-way": ">=9.7.0",
      "fast-uri": ">=4.1.2",
      "valibot": ">=1.4.2"
    }
  }
}
